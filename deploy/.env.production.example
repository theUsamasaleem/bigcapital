# ============================================================
# Finqora production env for self-hosting (copy to deploy/.env)
#   cp deploy/.env.production.example deploy/.env
# Then fill in the values marked CHANGE_ME.
# ============================================================

# --- Public URL (your Cloudflare tunnel hostname) ---
BASE_URL=https://finqora.YOURDOMAIN.com

# --- Auth secrets (already generated for you — keep private) ---
APP_JWT_SECRET=cyO9UevrkCmU4pPUBw-FGwNfihOWHdrgNxdH2gOZwzg
JWT_SECRET=eJyNOkHu-gfioeI3_MXLrFGd1PPKhPfgEhsSNC3B2PE

# --- Database (these create the local MariaDB container) ---
DB_ROOT_PASSWORD=CHANGE_ME_strong_root_password
DB_USER=finqora
DB_PASSWORD=CHANGE_ME_strong_db_password
DB_CHARSET=utf8
SYSTEM_DB_NAME=finqora_system
TENANT_DB_NAME_PERFIX=finqora_tenant_

# --- Mail (needed for invites / signup emails; Gmail app password example) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USERNAME=CHANGE_ME@gmail.com
MAIL_PASSWORD=CHANGE_ME_gmail_app_password
MAIL_FROM_NAME=Finqora
MAIL_FROM_ADDRESS=CHANGE_ME@gmail.com

# --- Sign-up ---
SIGNUP_DISABLED=false
SIGNUP_EMAIL_CONFIRMATION=false

# --- Exchange rate (optional; leave APP_ID blank if unused) ---
EXCHANGE_RATE_SERVICE=open-exchange-rate
OPEN_EXCHANGE_RATE_APP_ID=

# --- S3 placeholders (Attachments module boots; real uploads need real S3) ---
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=dev-local
S3_SECRET_ACCESS_KEY=dev-local
S3_BUCKET=dev-local-bucket
S3_ENDPOINT=
