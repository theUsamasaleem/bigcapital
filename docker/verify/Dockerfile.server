# Verification-only server image (Phase 1-3).
#
# A *thin overlay* on the existing demo image: it reuses the demo image's
# Alpine node_modules and only layers the freshly-compiled `dist`, the database
# migrations/seeds and the i18n assets on top. This avoids a full (heavy)
# rebuild — important when host disk is tight — and never touches the
# `:latest` image the live demo runs on.
#
# Build context = a directory containing `dist/`, `database/`, `i18n/`
# (see docker/verify/build.sh which assembles it from packages/server).
FROM bigcapitalhq/server:latest

USER root

# Freshly compiled application (pure JS — platform independent).
COPY dist /app/packages/server/dist
# Compiled migrations live in dist/database; raw assets/seed data live here too.
COPY database /app/packages/server/src/database
# i18n JSON assets are served from dist/i18n at runtime.
COPY i18n /app/packages/server/dist/i18n

RUN chown -R nodejs:nodejs /app/packages/server/dist /app/packages/server/src/database

USER nodejs
