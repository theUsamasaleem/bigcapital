# Verification-only migration runner. Built FROM the Phase 1-3 overlay image so
# it runs the new migrations/seeds against the *isolated* verify database.
FROM bigcapitalhq/server:phase3

USER root
WORKDIR /app/packages/server

# Wait for MySQL to accept connections, then run system + tenant migrations.
CMD ["sh", "-c", "until node -e \"require('net').connect(3306,'mysql').on('connect',()=>process.exit(0)).on('error',()=>process.exit(1))\" 2>/dev/null; do echo 'waiting for mysql...'; sleep 3; done; node dist/cli.js system:migrate:latest && node dist/cli.js tenants:migrate:latest && echo 'MIGRATIONS DONE'"]
